# ── Lokaler Test (kopiere nach .env, NICHT committen) ─────────────────────────
# Für `npm run dry-run` reicht der OpenAI-Key. Alles andere braucht nur die echte Pipeline.

# OpenAI (Caption-Text + Bild gpt-image-1)
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o

# E-Mail-Versand der Freigabe (SMTP-Postfach, z. B. welcome@mainilkanjo.de)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=welcome@mainilkanjo.de
SMTP_PASS=
SMTP_FROM=welcome@mainilkanjo.de
REVIEW_EMAIL_TO=welcome@mainilkanjo.de

# Freigabe-Endpoint auf dem WP-Server + geteiltes HMAC-Geheimnis
APPROVE_ENDPOINT=https://mainilkanjo.de/social-approve.php
APPROVE_SECRET=ein-langes-zufaelliges-geheimnis

# Optional: Bilder über eigene Domain ausliefern statt raw.githubusercontent.com
# IMAGE_BASE_URL=https://mainilkanjo.de/social-bilder

# Meta Graph API (Veröffentlichung)
IG_USER_ID=
FB_PAGE_ID=
META_ACCESS_TOKEN=
GRAPH_VERSION=v21.0
